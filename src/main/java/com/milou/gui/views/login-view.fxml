<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" fx:controller="com.milou.gui.controllers.LoginController" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.6">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Milou Login">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label text="Email:" />
    <TextField fx:id="emailField" promptText="Enter your email" />

    <Label text="Password:" />
    <PasswordField fx:id="passwordField" promptText="Enter your password" />

    <Button onAction="#loginButtonAction" text="Login" />

    <Label fx:id="statusLabel" textFill="RED" />

</VBox>