<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="500.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.milou.gui.controllers.ComposeController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <Label text="Compose New Email">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="To:" />
                <TextField fx:id="toField" GridPane.columnIndex="1" />
                <Label text="Subject:" GridPane.rowIndex="1" />
                <TextField fx:id="subjectField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
        <TextArea fx:id="bodyArea" prefHeight="200.0" wrapText="true" VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Label fx:id="statusLabel" textFill="RED" HBox.hgrow="ALWAYS" />
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancelButtonAction" text="Cancel" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#sendButtonAction" style="-fx-font-weight: bold;" text="Send" />
            </children>
        </HBox>
    </children>
</VBox>